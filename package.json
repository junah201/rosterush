{
  "name": "rosterush",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "pnpm --filter @rosterush/web dev",
    "build": "pnpm --filter @rosterush/web build",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "validate:games": "pnpm --filter @rosterush/games validate"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.5",
    "@types/node": "^24.19.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  }
}
