{
  "name": "@rosterush/api",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:init": "tsx scripts/create-tables.ts",
    "db:scan": "tsx scripts/scan.ts",
    "db:seed": "tsx scripts/seed-local.ts",
    "dev": "serverless offline --stage local",
    "deploy:dev": "serverless deploy --stage dev",
    "deploy:prod": "serverless deploy --stage prod",
    "aggregate:local": "tsx scripts/aggregate-local.ts",
    "og:preview": "tsx scripts/og-preview.ts"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1161.0",
    "@aws-sdk/client-s3": "^3.1161.0",
    "@aws-sdk/lib-dynamodb": "^3.1161.0",
    "@resvg/resvg-wasm": "^2.6.2",
    "@rosterush/core": "workspace:*",
    "@rosterush/games": "workspace:*",
    "satori": "^0.63.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.152",
    "serverless": "^4.46.0",
    "serverless-offline": "^14.8.4"
  }
}
